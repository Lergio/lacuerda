def guardar_version_si_corresponde(
    res_tab,
    nombre_artista,
    titulo,
    etiqueta,
    url_version,
    ruta_final_txt,
    nombre_archivo,
):
    soup_cancion = BeautifulSoup(res_tab.text, "html.parser")
    div_contenedor = soup_cancion.find("div", id=["tbody", "t_body"])
    bloque_tablatura = (
        div_contenedor.find("pre") if div_contenedor else soup_cancion.find("pre")
    )

    if not (bloque_tablatura and bloque_tablatura.text.strip()):
        print(f"         ⚠️ No se encontró el texto en {url_version}")
        return False

    contenido = (
        f"ARTISTA: {nombre_artista}\n"
        f"CANCION: {titulo}\n"
        f"VERSION: {etiqueta}\n"
        f"URL: {url_version}\n"
        + "=" * 40
        + "\n\n"
        + bloque_tablatura.text
    )
    escribir_archivo_atomico(ruta_final_txt, contenido)
    print(f"         ✅ ¡Descargada! -> {nombre_archivo}")
    return True


def calcular_versiones_cancion(cancion, ruta_artista_url):
    """Versiones esperables de una canción. No hace peticiones de red."""
    slug = normalizar_slug_cancion(cancion["href"])
    versiones = parsear_versiones(cancion.get("lcd", ""), slug, ruta_artista_url)
    base_nombre = nombre_seguro(cancion["titulo"])
    conteo_tipos = Counter(tipo for tipo, _, _ in versiones)
    contador_actual = {}
    resultado = []

    for tipo, url_version, _sufijo in versiones:
        if conteo_tipos[tipo] > 1:
            contador_actual[tipo] = contador_actual.get(tipo, 0) + 1
            etiqueta = f"{tipo} {contador_actual[tipo]}"
        else:
            etiqueta = tipo
        resultado.append({
            "tipo": tipo,
            "etiqueta": etiqueta,
            "url": url_version,
            "archivo": f"{base_nombre} - {etiqueta}.txt",
        })

    return resultado


def descargar_canciones_artista(
    session,
    artista,
    ruta_carpeta,
    estado,
    registro,
):
    nombre_artista = artista["nombre"]
    ruta_artista_url = ruta_artista_desde_url(artista["url"])
    canciones = artista.get("canciones", [])
    pendientes = []

    os.makedirs(ruta_carpeta, exist_ok=True)

    for i, cancion in enumerate(canciones, start=1):
        if SE_PIDIO_DETENER:
            break

        versiones = calcular_versiones_cancion(cancion, ruta_artista_url)

        print(
            f"      [{i}/{len(canciones)}] {cancion['titulo']} "
            f"({len(versiones)} versión/es)"
        )

        for v in versiones:
            item = crear_item_version(
                nombre_artista,
                cancion["titulo"],
                v["etiqueta"],
                v["url"],
                os.path.join(ruta_carpeta, v["archivo"]),
                v["archivo"],
            )

            if os.path.exists(item["ruta"]):
                estado["resumen"]["versiones_omitidas"] += 1
                registrar_descarga(registro, item, origen="existente")
                continue

            print(f"         🔗 [{v['tipo']}] {item['url']}")
            esperar()

            try:
                respuesta = obtener(session, item["url"])
            except Exception as e:
                motivo = mensaje_amigable_error(e)
                registrar_fallo(registro, item, motivo)
                if es_error_reintentable(e):
                    pendientes.append(item)
                else:
                    estado["resumen"]["versiones_fallidas"] += 1
                    estado["errores"].append({
                        "tipo": "cancion_conexion",
                        "url": item["url"],
                        "mensaje": motivo,
                    })
                continue

            if respuesta.status_code == 200:
                if guardar_version_si_corresponde(
                    respuesta,
                    item["artista"],
                    item["titulo"],
                    item["etiqueta"],
                    item["url"],
                    item["ruta"],
                    item["archivo"],
                ):
                    estado["resumen"]["versiones_descargadas"] += 1
                    registrar_descarga(registro, item)
                else:
                    estado["resumen"]["versiones_fallidas"] += 1
                    registrar_fallo(registro, item, MOTIVO_SIN_TEXTO)
            else:
                motivo = mensaje_amigable_codigo(respuesta.status_code)
                estado["resumen"]["versiones_fallidas"] += 1
                estado["errores"].append({
                    "tipo": "cancion_http",
                    "url": item["url"],
                    "mensaje": motivo,
                })
                registrar_fallo(registro, item, motivo)

            if SE_PIDIO_DETENER:
                break

    if pendientes and not SE_PIDIO_DETENER:
        print(f"      🔁 Reintentando {len(pendientes)} versión/es...")
        for item in pendientes:
            if SE_PIDIO_DETENER:
                break
            time.sleep(ESPERA_ENTRE_REINTENTOS)
            try:
                respuesta = obtener(session, item["url"], timeout=TIMEOUT_REINTENTO)
            except Exception as e:
                motivo = mensaje_amigable_error(e)
                estado["resumen"]["versiones_fallidas"] += 1
                estado["errores"].append({
                    "tipo": "reintento",
                    "url": item["url"],
                    "mensaje": motivo,
                })
                registrar_fallo(registro, item, motivo)
                continue

            if respuesta.status_code == 200 and guardar_version_si_corresponde(
                respuesta,
                item["artista"],
                item["titulo"],
                item["etiqueta"],
                item["url"],
                item["ruta"],
                item["archivo"],
            ):
                estado["resumen"]["versiones_descargadas"] += 1
                registrar_descarga(registro, item)
            else:
                estado["resumen"]["versiones_fallidas"] += 1
                if respuesta.status_code == 200:
                    motivo = MOTIVO_SIN_TEXTO
                else:
                    motivo = mensaje_amigable_codigo(respuesta.status_code)
                registrar_fallo(registro, item, motivo)


def contar_descargas_artista(nombre_artista):
    ruta = os.path.join(CARPETA_PRINCIPAL, nombre_artista.replace(" ", "_"))
    if not os.path.isdir(ruta):
        return 0, ruta
    cantidad = sum(1 for f in os.listdir(ruta) if f.lower().endswith(".txt"))
    return cantidad, ruta


