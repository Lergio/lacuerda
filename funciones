def verificar_indice_a():
    """Verifica una letra seleccionada: índice y primer artista."""
    letra = pedir_letra()
    session = crear_sesion()
    print(f"--- VERIFICACIÓN v5.3 | LETRA {letra.upper()} ---")

    url = url_indice(letra, 0)
    print(f"🔎 {url}")
    try:
        respuesta = obtener(session, url)
    except Exception as e:
        print(f"❌ {mensaje_amigable_error(e)}")
        return

    if respuesta.status_code != 200:
        print(f"❌ {mensaje_amigable_codigo(respuesta.status_code)}")
        return

    offsets = extraer_paginas_indice(respuesta.text, letra)
    artistas = extraer_artistas_indice(respuesta.text, letra)

    print("✅ Página índice responde 200")
    print(f"📑 Páginas detectadas: {offsets}")
    print(f"👥 Artistas en index0: {len(artistas)}")

    if artistas:
        primero = artistas[0]
        print(f"🎤 Primer artista: {primero['nombre']}")
        print(f"🔗 {primero['url']}")
        esperar()
        html, error = descargar_pagina_artista(session, primero)
        if error:
            print(f"❌ {error}")
            return
        canciones = extraer_canciones_artista(html, primero["url"])
        print(f"🎵 Canciones encontradas: {len(canciones)}")
        if canciones:
            print(f"   Ejemplo: {canciones[0]['titulo']} [{canciones[0]['lcd'] or '-'}]")


def mostrar_estado():
    letra = pedir_letra()
    ruta_json = os.path.join(carpeta_letra(letra), ARCHIVO_JSON)
    if not os.path.exists(ruta_json):
        print(f"No existe {ruta_json} todavía.")
        return

    with open(ruta_json, "r", encoding="utf-8") as f:
        estado = json.load(f)

    print(f"--- ESTADO v5.3 | LETRA {letra.upper()} ---")
    print(f"📁 Carpeta: {carpeta_letra(letra)}")
    print(json.dumps(estado.get("resumen", {}), ensure_ascii=False, indent=2))

    registro = cargar_registro_letra(letra)
    if registro:
        print(
            f"\n📊 Registro: {len(registro['descargadas'])} versiones descargadas | "
            f"fallidas -> índices: {len(registro['indices_fallidos'])}, "
            f"artistas: {len(registro['artistas_fallidos'])}, "
            f"versiones: {len(registro['fallidas'])}"
        )
        print(f"📄 Detalle en: {os.path.join(carpeta_letra(letra), ARCHIVO_REGISTRO_TXT)}")
    else:
        print("\nℹ️ Esta letra todavía no tiene registro de resultados.")
