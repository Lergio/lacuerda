def guardar_version_si_corresponde(
    res_tab,
    nombre_artista,
    titulo,
    etiqueta,
    url_version,
    ruta_final_txt,
    nombre_archivo,
):
    soup_cancion = BeautifulSoup(res_tab.text, "html.parser")
    div_contenedor = soup_cancion.find("div", id=["tbody", "t_body"])
    bloque_tablatura = (
        div_contenedor.find("pre") if div_contenedor else soup_cancion.find("pre")
    )

    if not (bloque_tablatura and bloque_tablatura.text.strip()):
        print(f"         ⚠️ No se encontró el texto en {url_version}")
        return False

    contenido = (
        f"ARTISTA: {nombre_artista}\n"
        f"CANCION: {titulo}\n"
        f"VERSION: {etiqueta}\n"
        f"URL: {url_version}\n"
        + "=" * 40
        + "\n\n"
        + bloque_tablatura.text
    )
    escribir_archivo_atomico(ruta_final_txt, contenido)
    print(f"         ✅ ¡Descargada! -> {nombre_archivo}")
    return True


def descargar_canciones_artista(
    session,
    artista,
    ruta_carpeta,
    estado,
):
    nombre_artista = artista["nombre"]
    ruta_artista_url = ruta_artista_desde_url(artista["url"])
    canciones = artista.get("canciones", [])
    pendientes = []

    os.makedirs(ruta_carpeta, exist_ok=True)

    for i, cancion in enumerate(canciones, start=1):
        if SE_PIDIO_DETENER:
            break

        slug = normalizar_slug_cancion(cancion["href"])
        versiones = parsear_versiones(cancion.get("lcd", ""), slug, ruta_artista_url)
        base_nombre = nombre_seguro(cancion["titulo"])
        conteo_tipos = Counter(tipo for tipo, _, _ in versiones)
        contador_actual = {}

        print(
            f"      [{i}/{len(canciones)}] {cancion['titulo']} "
            f"({len(versiones)} versión/es)"
        )

        for tipo, url_version, sufijo in versiones:
            if conteo_tipos[tipo] > 1:
                contador_actual[tipo] = contador_actual.get(tipo, 0) + 1
                etiqueta = f"{tipo} {contador_actual[tipo]}"
            else:
                etiqueta = tipo

            nombre_archivo = f"{base_nombre} - {etiqueta}.txt"
            ruta_final_txt = os.path.join(ruta_carpeta, nombre_archivo)

            if os.path.exists(ruta_final_txt):
                estado["resumen"]["versiones_omitidas"] += 1
                continue

            print(f"         🔗 [{tipo}] {url_version}")
            esperar()

            try:
                respuesta = obtener(session, url_version)
            except Exception as e:
                if es_error_reintentable(e):
                    pendientes.append({
                        "artista": nombre_artista,
                        "titulo": cancion["titulo"],
                        "etiqueta": etiqueta,
                        "url": url_version,
                        "ruta": ruta_final_txt,
                        "archivo": nombre_archivo,
                    })
                else:
                    estado["resumen"]["versiones_fallidas"] += 1
                    estado["errores"].append({
                        "tipo": "cancion_conexion",
                        "url": url_version,
                        "mensaje": mensaje_amigable_error(e),
                    })
                continue

            if respuesta.status_code == 200:
                if guardar_version_si_corresponde(
                    respuesta,
                    nombre_artista,
                    cancion["titulo"],
                    etiqueta,
                    url_version,
                    ruta_final_txt,
                    nombre_archivo,
                ):
                    estado["resumen"]["versiones_descargadas"] += 1
                else:
                    estado["resumen"]["versiones_fallidas"] += 1
            else:
                estado["resumen"]["versiones_fallidas"] += 1
                estado["errores"].append({
                    "tipo": "cancion_http",
                    "url": url_version,
                    "mensaje": mensaje_amigable_codigo(respuesta.status_code),
                })

            if SE_PIDIO_DETENER:
                break

    if pendientes and not SE_PIDIO_DETENER:
        print(f"      🔁 Reintentando {len(pendientes)} versión/es...")
        for item in pendientes:
            if SE_PIDIO_DETENER:
                break
            time.sleep(ESPERA_ENTRE_REINTENTOS)
            try:
                respuesta = obtener(session, item["url"], timeout=TIMEOUT_REINTENTO)
            except Exception as e:
                estado["resumen"]["versiones_fallidas"] += 1
                estado["errores"].append({
                    "tipo": "reintento",
                    "url": item["url"],
                    "mensaje": mensaje_amigable_error(e),
                })
                continue

            if respuesta.status_code == 200 and guardar_version_si_corresponde(
                respuesta,
                item["artista"],
                item["titulo"],
                item["etiqueta"],
                item["url"],
                item["ruta"],
                item["archivo"],
            ):
                estado["resumen"]["versiones_descargadas"] += 1
            else:
                estado["resumen"]["versiones_fallidas"] += 1


def contar_descargas_artista(nombre_artista):
    ruta = os.path.join(CARPETA_PRINCIPAL, nombre_artista.replace(" ", "_"))
    if not os.path.isdir(ruta):
        return 0, ruta
    cantidad = sum(1 for f in os.listdir(ruta) if f.lower().endswith(".txt"))
    return cantidad, ruta


# ---------------------------------------------------------------------------
# Recorrido principal
# ---------------------------------------------------------------------------

def pedir_letra():
    """Solicita una única letra del índice alfabético."""
    while True:
        letra = input("Ingresá la letra que querés scrapear (A-Z): ").strip().lower()
        if letra in LETRAS:
            return letra
        print("⚠️ Letra inválida. Ingresá una letra entre A y Z.")


def recalcular_resumen(estado):
    """Recalcula los contadores derivados a partir del contenido de la letra."""
    estado["resumen"]["artistas_encontrados"] = len(estado["artistas"])
    estado["resumen"]["canciones_encontradas"] = sum(
        len(a.get("canciones", [])) for a in estado["artistas"]
    )


def procesar_letra(letra=None):
    """Recorre exclusivamente una letra y guarda todo dentro de su carpeta."""
    global SE_PIDIO_DETENER
    SE_PIDIO_DETENER = False

    if letra is None:
        letra = pedir_letra()

    ruta_letra = carpeta_letra(letra)
    os.makedirs(ruta_letra, exist_ok=True)

    print(f"--- LaCuerda Downloader v5.2 | LETRA {letra.upper()} ---")
    print(f"📁 Carpeta de trabajo: {ruta_letra}")
    print("🔗 Se utilizará UNA sesión HTTP reutilizable para toda esta letra.")
    print(f"⏱️ Espera entre peticiones: {ESPERA_ENTRE_PETICIONES}s")

    estado = cargar_estado_letra(letra) or nuevo_estado(letra)
    estado["fin"] = None
    session = crear_sesion()

    # El JSON existente permite continuar un recorrido interrumpido sin perder
    # los artistas ya descubiertos. Para una actualización futura de la letra,
    # se vuelve a consultar el índice y se agregan/corrigen artistas.
    artistas_por_url = {a["url"].rstrip("/"): a for a in estado.get("artistas", [])}
    offsets_vistos = set(estado.get("paginas_indice", []))
    pagina_offsets = [0]
    paginas_procesadas_en_esta_ejecucion = set()

    print("\n========== ÍNDICES ==========")
    while pagina_offsets and not SE_PIDIO_DETENER:
        offset = pagina_offsets.pop(0)
        if offset in paginas_procesadas_en_esta_ejecucion:
            continue
        paginas_procesadas_en_esta_ejecucion.add(offset)

        esperar()
        html, error = obtener_indice(session, letra, offset)

        if offset not in estado["paginas_indice"]:
            estado["paginas_indice"].append(offset)
            estado["paginas_indice"].sort()
        estado["resumen"]["paginas_indice"] = len(estado["paginas_indice"])

        if error:
            estado["errores"].append(error)
            guardar_control(estado)
            continue

        nuevos_offsets = extraer_paginas_indice(html, letra)
        for nuevo in nuevos_offsets:
            if nuevo not in paginas_procesadas_en_esta_ejecucion and nuevo not in pagina_offsets:
                pagina_offsets.append(nuevo)

        artistas = extraer_artistas_indice(html, letra)
        print(f"      👥 Artistas encontrados en esta página: {len(artistas)}")

        for artista in artistas:
            clave = artista["url"].rstrip("/")
            if clave in artistas_por_url:
                # Actualizamos datos básicos del índice, pero conservamos las
                # canciones ya descubiertas durante una ejecución anterior.
                existente = artistas_por_url[clave]
                existente["nombre"] = artista["nombre"]
                existente["letra_indice"] = artista["letra_indice"]
                existente["canciones_declaradas"] = artista["canciones_declaradas"]
            else:
                artistas_por_url[clave] = artista
                estado["artistas"].append(artista)

        recalcular_resumen(estado)
        guardar_control(estado)

    print(f"\n👥 Total de artistas de {letra.upper()}: {len(estado['artistas'])}")

    print("\n========== ARTISTAS ==========")
    for numero, artista in enumerate(estado["artistas"], start=1):
        if SE_PIDIO_DETENER:
            break

        print(f"\n[{numero}/{len(estado['artistas'])}] {artista['nombre']}")
        esperar()
        html, error = descargar_pagina_artista(session, artista)

        if error:
            artista["error"] = error
            estado["errores"].append({
                "tipo": "artista",
                "url": artista["url"],
                "mensaje": error,
            })
            guardar_control(estado)
            continue

        artista.pop("error", None)
        artista["canciones"] = extraer_canciones_artista(html, artista["url"])
        artista["canciones_encontradas"] = len(artista["canciones"])

        if (
            artista.get("canciones_declaradas") is not None
            and artista["canciones_declaradas"] != len(artista["canciones"])
        ):
            artista["advertencia_cantidad"] = (
                f"La página declara {artista['canciones_declaradas']} "
                f"y se encontraron {len(artista['canciones'])}."
            )
        else:
            artista.pop("advertencia_cantidad", None)

        ruta_artista = os.path.join(
            ruta_letra,
            nombre_seguro(artista["nombre"]).replace(" ", "_"),
        )
        artista["carpeta"] = ruta_artista

        estado["resumen"]["artistas_procesados"] = sum(
            1 for a in estado["artistas"] if "canciones" in a and not a.get("error")
        )
        recalcular_resumen(estado)
        guardar_control(estado)

        descargar_canciones_artista(session, artista, ruta_artista, estado)
        guardar_control(estado)

    estado["fin"] = time.strftime("%Y-%m-%d %H:%M:%S")
    recalcular_resumen(estado)
    guardar_control(estado)

    print("\n========== RESUMEN ==========")
    for clave, valor in estado["resumen"].items():
        print(f"{clave}: {valor}")

    if SE_PIDIO_DETENER:
        print("\n⏸️ Letra detenida. El JSON/TXT conserva el avance parcial.")
    else:
        print(f"\n✅ Letra {letra.upper()} terminada.")

    print(f"📁 Carpeta: {ruta_letra}")
    print(f"📄 JSON: {os.path.join(ruta_letra, ARCHIVO_JSON)}")
    print(f"📄 TXT:  {os.path.join(ruta_letra, ARCHIVO_TXT)}")


def procesar_biblioteca_completa():
    """Compatibilidad: ahora solicita una letra y procesa solamente esa letra."""
    procesar_letra()


def verificar_indice_a():
    """Verifica una letra seleccionada: índice y primer artista."""
    letra = pedir_letra()
    session = crear_sesion()
    print(f"--- VERIFICACIÓN v5.2 | LETRA {letra.upper()} ---")

    url = url_indice(letra, 0)
    print(f"🔎 {url}")
    try:
        respuesta = obtener(session, url)
    except Exception as e:
        print(f"❌ {mensaje_amigable_error(e)}")
        return

    if respuesta.status_code != 200:
        print(f"❌ {mensaje_amigable_codigo(respuesta.status_code)}")
        return

    offsets = extraer_paginas_indice(respuesta.text, letra)
    artistas = extraer_artistas_indice(respuesta.text, letra)

    print("✅ Página índice responde 200")
    print(f"📑 Páginas detectadas: {offsets}")
    print(f"👥 Artistas en index0: {len(artistas)}")

    if artistas:
        primero = artistas[0]
        print(f"🎤 Primer artista: {primero['nombre']}")
        print(f"🔗 {primero['url']}")
        esperar()
        html, error = descargar_pagina_artista(session, primero)
        if error:
            print(f"❌ {error}")
            return
        canciones = extraer_canciones_artista(html, primero["url"])
        print(f"🎵 Canciones encontradas: {len(canciones)}")
        if canciones:
            print(f"   Ejemplo: {canciones[0]['titulo']} [{canciones[0]['lcd'] or '-'}]")


def mostrar_estado():
    letra = pedir_letra()
    ruta_json = os.path.join(carpeta_letra(letra), ARCHIVO_JSON)
    if not os.path.exists(ruta_json):
        print(f"No existe {ruta_json} todavía.")
        return

    with open(ruta_json, "r", encoding="utf-8") as f:
        estado = json.load(f)

    print(f"--- ESTADO v5.2 | LETRA {letra.upper()} ---")
    print(f"📁 Carpeta: {carpeta_letra(letra)}")
    print(json.dumps(estado.get("resumen", {}), ensure_ascii=False, indent=2))
