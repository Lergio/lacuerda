def pedir_letra():
    """Solicita una única letra del índice alfabético."""
    while True:
        letra = input("Ingresá la letra que querés scrapear (A-Z): ").strip().lower()
        if letra in LETRAS:
            return letra
        print("⚠️ Letra inválida. Ingresá una letra entre A y Z.")


def recalcular_resumen(estado):
    """Recalcula los contadores derivados a partir del contenido de la letra."""
    estado["resumen"]["artistas_encontrados"] = len(estado["artistas"])
    estado["resumen"]["canciones_encontradas"] = sum(
        len(a.get("canciones", [])) for a in estado["artistas"]
    )


def limpiar_errores_url(estado, url):
    """Quita de estado['errores'] los errores viejos asociados a una URL."""
    estado["errores"] = [e for e in estado["errores"] if e.get("url") != url]


def recalcular_procesados(estado):
    estado["resumen"]["artistas_procesados"] = sum(
        1 for a in estado["artistas"] if "canciones" in a and not a.get("error")
    )


def procesar_pagina_indice(session, letra, offset, estado, registro, artistas_por_url):
    """
    Descarga y procesa una página de índice.
    Devuelve (offsets_de_paginas, artistas_nuevos), o None si falló.
    """
    esperar()
    html, error = obtener_indice(session, letra, offset)
    url = url_indice(letra, offset)

    if offset not in estado["paginas_indice"]:
        estado["paginas_indice"].append(offset)
        estado["paginas_indice"].sort()
    estado["resumen"]["paginas_indice"] = len(estado["paginas_indice"])

    limpiar_errores_url(estado, url)

    if error:
        estado["errores"].append(error)
        registrar_fallo_en(
            registro,
            "indices_fallidos",
            {"offset": offset, "url": url},
            error["mensaje"],
        )
        guardar_control(estado)
        guardar_registro(registro)
        return None

    resolver_fallo(registro, "indices_fallidos", url)

    nuevos_offsets = extraer_paginas_indice(html, letra)
    artistas = extraer_artistas_indice(html, letra)
    print(f"      👥 Artistas encontrados en esta página: {len(artistas)}")

    nuevos = []
    for artista in artistas:
        clave = artista["url"].rstrip("/")
        if clave in artistas_por_url:
            # Actualizamos datos básicos del índice, pero conservamos las
            # canciones ya descubiertas durante una ejecución anterior.
            existente = artistas_por_url[clave]
            existente["nombre"] = artista["nombre"]
            existente["letra_indice"] = artista["letra_indice"]
            existente["canciones_declaradas"] = artista["canciones_declaradas"]
        else:
            artistas_por_url[clave] = artista
            estado["artistas"].append(artista)
            nuevos.append(artista)

    recalcular_resumen(estado)
    guardar_control(estado)
    guardar_registro(registro)
    return nuevos_offsets, nuevos


def procesar_artista(session, artista, ruta_letra, estado, registro):
    """
    Descarga la página de un artista y todas sus canciones.
    Devuelve True si la página del artista se pudo leer.
    """
    esperar()
    html, error = descargar_pagina_artista(session, artista)
    limpiar_errores_url(estado, artista["url"])

    if error:
        artista["error"] = error
        estado["errores"].append({
            "tipo": "artista",
            "url": artista["url"],
            "mensaje": error,
        })
        registrar_fallo_en(
            registro,
            "artistas_fallidos",
            {
                "nombre": artista["nombre"],
                "url": artista["url"],
                "canciones_declaradas": artista.get("canciones_declaradas"),
            },
            error,
        )
        guardar_control(estado)
        guardar_registro(registro)
        return False

    artista.pop("error", None)
    resolver_fallo(registro, "artistas_fallidos", artista["url"])
    artista["canciones"] = extraer_canciones_artista(html, artista["url"])
    artista["canciones_encontradas"] = len(artista["canciones"])

    if (
        artista.get("canciones_declaradas") is not None
        and artista["canciones_declaradas"] != len(artista["canciones"])
    ):
        artista["advertencia_cantidad"] = (
            f"La página declara {artista['canciones_declaradas']} "
            f"y se encontraron {len(artista['canciones'])}."
        )
    else:
        artista.pop("advertencia_cantidad", None)

    ruta_artista = os.path.join(
        ruta_letra,
        nombre_seguro(artista["nombre"]).replace(" ", "_"),
    )
    artista["carpeta"] = ruta_artista

    recalcular_procesados(estado)
    recalcular_resumen(estado)
    guardar_control(estado)

    descargar_canciones_artista(session, artista, ruta_artista, estado, registro)
    guardar_control(estado)
    guardar_registro(registro)
    return True


def procesar_letra(letra=None):
    """Recorre exclusivamente una letra y guarda todo dentro de su carpeta."""
    global SE_PIDIO_DETENER
    SE_PIDIO_DETENER = False

    if letra is None:
        letra = pedir_letra()

    ruta_letra = carpeta_letra(letra)
    os.makedirs(ruta_letra, exist_ok=True)

    print(f"--- LaCuerda Downloader v{VERSION_SCRIPT} | LETRA {letra.upper()} ---")
    print(f"📁 Carpeta de trabajo: {ruta_letra}")
    print("🔗 Se utilizará UNA sesión HTTP reutilizable para toda esta letra.")
    print(f"⏱️ Espera entre peticiones: {ESPERA_ENTRE_PETICIONES}s")

    estado = cargar_estado_letra(letra) or nuevo_estado(letra)
    estado["fin"] = None
    registro = cargar_registro_letra(letra) or nuevo_registro(letra)
    session = crear_sesion()

    # El JSON existente permite continuar un recorrido interrumpido sin perder
    # los artistas ya descubiertos. Para una actualización futura de la letra,
    # se vuelve a consultar el índice y se agregan/corrigen artistas.
    artistas_por_url = {a["url"].rstrip("/"): a for a in estado.get("artistas", [])}
    pagina_offsets = [0]
    paginas_procesadas_en_esta_ejecucion = set()

    print("\n========== ÍNDICES ==========")
    while pagina_offsets and not SE_PIDIO_DETENER:
        offset = pagina_offsets.pop(0)
        if offset in paginas_procesadas_en_esta_ejecucion:
            continue
        paginas_procesadas_en_esta_ejecucion.add(offset)

        resultado = procesar_pagina_indice(
            session, letra, offset, estado, registro, artistas_por_url
        )
        if resultado is None:
            continue

        nuevos_offsets, _nuevos = resultado
        for nuevo in nuevos_offsets:
            if nuevo not in paginas_procesadas_en_esta_ejecucion and nuevo not in pagina_offsets:
                pagina_offsets.append(nuevo)

    print(f"\n👥 Total de artistas de {letra.upper()}: {len(estado['artistas'])}")

    print("\n========== ARTISTAS ==========")
    for numero, artista in enumerate(estado["artistas"], start=1):
        if SE_PIDIO_DETENER:
            break

        print(f"\n[{numero}/{len(estado['artistas'])}] {artista['nombre']}")
        procesar_artista(session, artista, ruta_letra, estado, registro)

    estado["fin"] = _ahora()
    recalcular_resumen(estado)
    guardar_control(estado)
    guardar_registro(registro)

    print("\n========== RESUMEN ==========")
    for clave, valor in estado["resumen"].items():
        print(f"{clave}: {valor}")

    if SE_PIDIO_DETENER:
        print("\n⏸️ Letra detenida. El JSON/TXT conserva el avance parcial.")
    else:
        print(f"\n✅ Letra {letra.upper()} terminada.")

    print(f"📁 Carpeta: {ruta_letra}")
    print(f"📄 JSON: {os.path.join(ruta_letra, ARCHIVO_JSON)}")
    print(f"📄 TXT:  {os.path.join(ruta_letra, ARCHIVO_TXT)}")
    print(f"📄 Registro: {os.path.join(ruta_letra, ARCHIVO_REGISTRO_JSON)}")
    print(f"📄 Registro: {os.path.join(ruta_letra, ARCHIVO_REGISTRO_TXT)}")
    print(
        f"\n📊 Versiones descargadas: {len(registro['descargadas'])}"
        f"\n❌ Fallidas -> índices: {len(registro['indices_fallidos'])} | "
        f"artistas: {len(registro['artistas_fallidos'])} | "
        f"versiones: {len(registro['fallidas'])}"
    )
    if contar_pendientes(registro):
        print("🔁 Podés reintentar solo lo que falló desde el menú.")


def reconstruir_registro(letra):
    """
    Arma el registro de una letra procesada con una versión anterior, sin red:
    toma artistas.json (errores y artistas con error) y comprueba qué archivos
    .txt existen en disco.
    """
    estado = cargar_estado_letra(letra)
    registro = nuevo_registro(letra)
    if not estado:
        return registro

    motivos_previos = {
        e.get("url"): e.get("mensaje")
        for e in estado.get("errores", [])
        if e.get("url")
    }

    # Páginas de índice con error
    for e in estado.get("errores", []):
        if e.get("tipo") not in ("indice_conexion", "indice_http"):
            continue
        m = re.search(r"index(\d+)\.html", e.get("url", ""))
        if m:
            registrar_fallo_en(
                registro,
                "indices_fallidos",
                {"offset": int(m.group(1)), "url": e["url"]},
                e.get("mensaje", "error al leer el índice"),
                intentos_previos=0,
            )

    for artista in estado.get("artistas", []):
        # Páginas de artista con error
        if artista.get("error"):
            registrar_fallo_en(
                registro,
                "artistas_fallidos",
                {
                    "nombre": artista["nombre"],
                    "url": artista["url"],
                    "canciones_declaradas": artista.get("canciones_declaradas"),
                },
                artista["error"],
                intentos_previos=0,
            )

        # Versiones: existe el archivo o falta
        ruta_artista = artista.get("carpeta")
        if not ruta_artista or not artista.get("canciones"):
            continue
        ruta_artista_url = ruta_artista_desde_url(artista["url"])

        for cancion in artista["canciones"]:
            for v in calcular_versiones_cancion(cancion, ruta_artista_url):
                item = crear_item_version(
                    artista["nombre"],
                    cancion["titulo"],
                    v["etiqueta"],
                    v["url"],
                    os.path.join(ruta_artista, v["archivo"]),
                    v["archivo"],
                )
                if os.path.exists(item["ruta"]):
                    registrar_descarga(registro, item, origen="existente")
                else:
                    motivo = motivos_previos.get(item["url"]) or (
                        "archivo faltante (detectado al reconstruir desde artistas.json)"
                    )
                    registrar_fallo(registro, item, motivo, intentos_previos=0)

    return registro


def _reintentar_versiones(session, registro):
    """Reintenta las versiones fallidas. Devuelve las URLs resueltas."""
    fallidas = list(registro["fallidas"].values())
    resueltas = []
    if not fallidas:
        return resueltas

    print(f"\n========== VERSIONES FALLIDAS ({len(fallidas)}) ==========")

    for numero, item in enumerate(fallidas, start=1):
        if SE_PIDIO_DETENER:
            break

        print(
            f"\n[{numero}/{len(fallidas)}] {item['artista']} - "
            f"{item['titulo']} [{item['etiqueta']}]"
        )

        # Puede haberse descargado por otro camino desde la última corrida.
        if os.path.exists(item["ruta"]):
            print("         ✅ El archivo ya existe en disco.")
            registrar_descarga(registro, item, origen="existente")
            resueltas.append(item["url"])
            continue

        print(f"         🔗 {item['url']}")
        esperar()

        try:
            respuesta = obtener(session, item["url"], timeout=TIMEOUT_REINTENTO)
        except Exception as e:
            motivo = mensaje_amigable_error(e)
            print(f"         ❌ {motivo}")
            registrar_fallo(registro, item, motivo)
            continue

        if respuesta.status_code != 200:
            motivo = mensaje_amigable_codigo(respuesta.status_code)
            print(f"         ❌ {motivo}")
            registrar_fallo(registro, item, motivo)
            continue

        if guardar_version_si_corresponde(
            respuesta,
            item["artista"],
            item["titulo"],
            item["etiqueta"],
            item["url"],
            item["ruta"],
            item["archivo"],
        ):
            registrar_descarga(registro, item, origen="reintento")
            resueltas.append(item["url"])
        else:
            registrar_fallo(registro, item, MOTIVO_SIN_TEXTO)

        if numero % 10 == 0:
            guardar_registro(registro)

    return resueltas


def reintentar_fallidas(letra=None):
    """
    Reintenta SOLO lo que falló en una letra, en este orden:
      1) páginas de índice  2) versiones sueltas  3) páginas de artista
    No vuelve a recorrer lo que ya salió bien.
    """
    global SE_PIDIO_DETENER
    SE_PIDIO_DETENER = False

    if letra is None:
        letra = pedir_letra()

    ruta_letra = carpeta_letra(letra)
    print(f"--- REINTENTAR FALLIDAS v{VERSION_SCRIPT} | LETRA {letra.upper()} ---")

    estado = cargar_estado_letra(letra)
    registro = cargar_registro_letra(letra)

    if registro is None:
        if estado is None:
            print(f"No hay datos de la letra {letra.upper()} todavía. Primero usá la opción 1.")
            return
        print("ℹ️ Esta letra no tiene registro de resultados (se procesó con una versión anterior).")
        print("   Reconstruyéndolo desde artistas.json y los archivos que hay en disco...")
        registro = reconstruir_registro(letra)
        guardar_registro(registro)

    if estado is None:
        estado = nuevo_estado(letra)

    if contar_pendientes(registro) == 0:
        print(f"✅ No hay nada fallido en la letra {letra.upper()}.")
        return

    print(
        f"🔁 Pendientes -> índices: {len(registro['indices_fallidos'])} | "
        f"versiones: {len(registro['fallidas'])} | "
        f"artistas: {len(registro['artistas_fallidos'])}"
    )
    print(f"⏱️ Espera entre peticiones: {ESPERA_ENTRE_PETICIONES}s")

    session = crear_sesion()
    artistas_por_url = {a["url"].rstrip("/"): a for a in estado["artistas"]}
    resumen = {"indices": 0, "versiones": 0, "artistas": 0}

    # ---------------------------------------------------- 1) índices
    nuevos_artistas = []
    pendientes_offsets = sorted(i["offset"] for i in registro["indices_fallidos"].values())
    if pendientes_offsets:
        print(f"\n========== ÍNDICES FALLIDOS ({len(pendientes_offsets)}) ==========")
    ya_probados = set()
    while pendientes_offsets and not SE_PIDIO_DETENER:
        offset = pendientes_offsets.pop(0)
        if offset in ya_probados:
            continue
        ya_probados.add(offset)

        resultado = procesar_pagina_indice(
            session, letra, offset, estado, registro, artistas_por_url
        )
        if resultado is None:
            continue

        resumen["indices"] += 1
        nuevos_offsets, nuevos = resultado
        nuevos_artistas.extend(nuevos)
        # Páginas que antes no se habían descubierto por este índice caído
        for nuevo in nuevos_offsets:
            if (
                nuevo not in estado["paginas_indice"]
                and nuevo not in ya_probados
                and nuevo not in pendientes_offsets
            ):
                pendientes_offsets.append(nuevo)

    # --------------------------------------------------- 2) versiones
    resueltas = _reintentar_versiones(session, registro)
    resumen["versiones"] = len(resueltas)
    if resueltas:
        resueltas_set = set(resueltas)
        r = estado["resumen"]
        r["versiones_descargadas"] += len(resueltas)
        r["versiones_fallidas"] = max(0, r["versiones_fallidas"] - len(resueltas))
        estado["errores"] = [
            e for e in estado["errores"] if e.get("url") not in resueltas_set
        ]
    guardar_control(estado)
    guardar_registro(registro)

    # ---------------------------------------------------- 3) artistas
    artistas_a_procesar = []
    for item in list(registro["artistas_fallidos"].values()):
        artista = artistas_por_url.get(item["url"].rstrip("/"))
        if artista is None:
            artista = {
                "nombre": item["nombre"],
                "url": item["url"],
                "letra_indice": letra,
                "canciones_declaradas": item.get("canciones_declaradas"),
            }
            estado["artistas"].append(artista)
            artistas_por_url[item["url"].rstrip("/")] = artista
        artistas_a_procesar.append(artista)
    for artista in nuevos_artistas:
        if not any(artista is a for a in artistas_a_procesar):
            artistas_a_procesar.append(artista)

    if artistas_a_procesar:
        print(f"\n========== ARTISTAS ({len(artistas_a_procesar)}) ==========")
    for numero, artista in enumerate(artistas_a_procesar, start=1):
        if SE_PIDIO_DETENER:
            break
        print(f"\n[{numero}/{len(artistas_a_procesar)}] {artista['nombre']}")
        if procesar_artista(session, artista, ruta_letra, estado, registro):
            resumen["artistas"] += 1

    recalcular_procesados(estado)
    recalcular_resumen(estado)
    guardar_control(estado)
    guardar_registro(registro)

    print("\n========== RESULTADO ==========")
    print(
        f"Resueltos en esta pasada -> índices: {resumen['indices']} | "
        f"versiones: {resumen['versiones']} | artistas: {resumen['artistas']}"
    )
    print(
        f"Siguen fallando          -> índices: {len(registro['indices_fallidos'])} | "
        f"versiones: {len(registro['fallidas'])} | "
        f"artistas: {len(registro['artistas_fallidos'])}"
    )
    print(f"Versiones descargadas en total: {len(registro['descargadas'])}")
    if SE_PIDIO_DETENER:
        print("\n⏸️ Reintento detenido. Lo pendiente sigue en el registro.")
    print(f"📄 Registro: {os.path.join(ruta_letra, ARCHIVO_REGISTRO_TXT)}")


