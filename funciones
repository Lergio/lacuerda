def extraer_canciones_artista(html, url_artista):
    soup = BeautifulSoup(html, "html.parser")
    ul = soup.find("ul", id="b_main")
    if not ul:
        return []

    canciones = []
    vistos = set()

    for li in ul.find_all("li", recursive=False):
        enlace = li.find("a", href=True)
        if not enlace:
            continue

        href = enlace["href"].strip()
        if not href:
            continue

        titulo = enlace.get_text(" ", strip=True)
        em = enlace.find("em")
        if em:
            titulo = titulo.replace(em.get_text(" ", strip=True), "").strip()

        clave = (href, titulo)
        if clave in vistos:
            continue
        vistos.add(clave)

        canciones.append({
            "id": li.get("id", ""),
            "titulo": titulo,
            "href": href,
            "url": urljoin(url_artista.rstrip("/") + "/", href),
            "lcd": li.get("lcd", ""),
        })

    return canciones


def normalizar_slug_cancion(href):
    path = urlparse(href).path
    slug = path.rstrip("/").split("/")[-1]
    slug = re.sub(r"\.shtml$", "", slug, flags=re.IGNORECASE)
    return slug


def parsear_versiones(lcd, slug, ruta_artista_url):
    versiones = []
    if not lcd or "-" not in lcd:
        return [
            (
                "Acordes",
                f"{DOMINIO_BASE}/{ruta_artista_url}/{slug}.shtml",
                1,
            )
        ]

    letras, numeros = lcd.split("-", 1)
    if len(letras) != len(numeros):
        return [
            (
                "Acordes",
                f"{DOMINIO_BASE}/{ruta_artista_url}/{slug}.shtml",
                1,
            )
        ]

    for letra, numero in zip(letras, numeros):
        try:
            sufijo = int(numero)
        except ValueError:
            continue

        tipo = TIPOS.get(letra, letra)
        sufijo_url = "" if sufijo == 1 else f"-{sufijo}"
        url = f"{DOMINIO_BASE}/{ruta_artista_url}/{slug}{sufijo_url}.shtml"
        versiones.append((tipo, url, sufijo))

    versiones.sort(key=lambda x: x[2])
    return versiones


def ruta_artista_desde_url(url):
    path = urlparse(url).path.strip("/")
    return path.split("/")[-1] if path else ""


def descargar_pagina_artista(session, artista):
    url = artista["url"]
    print(f"   🎤 {artista['nombre']} -> {url}")

    try:
        respuesta = obtener(session, url)
    except Exception as e:
        return None, mensaje_amigable_error(e)

    if respuesta.status_code != 200:
        return None, mensaje_amigable_codigo(respuesta.status_code)

    return respuesta.text, None


