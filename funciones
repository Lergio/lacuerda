"""
funciones.py
------------------
Crawler + descargador de LaCuerda v5.2.

Flujo:
    indice alfabetico -> paginas indexXXX -> artistas -> canciones -> versiones
    -> archivos TXT

Mantiene una unica requests.Session() durante todo el recorrido para permitir
reutilizacion de conexiones HTTP.
"""

import json
import os
import re
import signal
import sys
import time
import unicodedata
from collections import Counter
from urllib.parse import quote, urljoin, urlparse

import requests
from bs4 import BeautifulSoup

DOMINIO_BASE = "https://acordes.lacuerda.net"
URL_TABS = f"{DOMINIO_BASE}/tabs"
CARPETA_PRINCIPAL = "Biblioteca_LaCuerda"
ARCHIVO_JSON = "artistas.json"
ARCHIVO_TXT = "artistas.txt"

# Cada letra tiene su propia carpeta para poder actualizarla de forma independiente.
# Ejemplo: Biblioteca_LaCuerda/a/artistas.json

def carpeta_letra(letra):
    return os.path.join(CARPETA_PRINCIPAL, letra.lower())

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/154.0.0.0 Safari/537.36"
    ),
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Connection": "keep-alive",
}

TIMEOUT_SEGUNDOS = 20
TIMEOUT_REINTENTO = 30
ESPERA_ENTRE_PETICIONES = 1.0
ESPERA_ENTRE_REINTENTOS = 2.0

# Se puede modificar si el sitio agrega/quita letras en el indice.
LETRAS = list("abcdefghijklmnopqrstuvwxyz")

TIPOS = {
    "R": "Acordes",
    "T": "Tablatura",
    "B": "Bajo",
    "H": "Armonica",
    "K": "Teclado",
}

SE_PIDIO_DETENER = False


# ---------------------------------------------------------------------------
# Interrupciones
# ---------------------------------------------------------------------------

def _manejar_senal_interrupcion(signum, frame):
    global SE_PIDIO_DETENER
    if not SE_PIDIO_DETENER:
        print("\n\n🛑 Se pidió detener el script.")
        print("   Terminando el ítem actual y guardando el control parcial...")
        print("   (Ctrl+C nuevamente fuerza la salida inmediata)")
        SE_PIDIO_DETENER = True
    else:
        print("\n❌ Corte forzado por el usuario.")
        sys.exit(1)


def instalar_manejador_interrupciones():
    signal.signal(signal.SIGINT, _manejar_senal_interrupcion)
    try:
        signal.signal(signal.SIGTERM, _manejar_senal_interrupcion)
    except (AttributeError, ValueError):
        pass


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

def crear_sesion():
    """Crea UNA sesión que se reutiliza durante todo el scraping."""
    session = requests.Session()
    session.headers.update(HEADERS)
    return session


def obtener(session, url, timeout=TIMEOUT_SEGUNDOS):
    """GET usando la sesión persistente."""
    return session.get(url, timeout=timeout)


def mensaje_amigable_error(excepcion):
    if isinstance(excepcion, requests.exceptions.Timeout):
        return "el servidor tardó demasiado en responder"
    if isinstance(excepcion, requests.exceptions.ConnectionError):
        return "no se pudo establecer conexión con el servidor"
    if isinstance(excepcion, requests.exceptions.RequestException):
        return "hubo un problema de conexión"
    return "ocurrió un error inesperado"


def es_error_reintentable(excepcion):
    return isinstance(
        excepcion,
        (requests.exceptions.Timeout, requests.exceptions.ConnectionError),
    )


MENSAJES_POR_CODIGO = {
    403: "acceso rechazado por el servidor",
    404: "la página no existe",
    429: "demasiadas solicitudes; el servidor pidió esperar",
    500: "error interno del servidor",
    502: "servidor no disponible momentáneamente",
    503: "servicio no disponible en este momento",
    504: "el servidor tardó demasiado en responder",
}


def mensaje_amigable_codigo(codigo):
    return MENSAJES_POR_CODIGO.get(codigo, f"respuesta HTTP {codigo}")


def esperar():
    if ESPERA_ENTRE_PETICIONES > 0:
        time.sleep(ESPERA_ENTRE_PETICIONES)


# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------

def nombre_seguro(texto):
    limpio = "".join(
        c for c in texto if c.isalnum() or c in (" ", "_", "-", ".")
    ).strip()
    limpio = re.sub(r"\s+", " ", limpio)
    return limpio or "Sin_nombre"


def slugify_artista(nombre):
    con_ni = nombre.replace("ñ", "ni").replace("Ñ", "Ni")
    sin_tildes = unicodedata.normalize("NFKD", con_ni)
    sin_tildes = "".join(c for c in sin_tildes if not unicodedata.combining(c))
    slug = re.sub(r"[^a-z0-9]+", "_", sin_tildes.lower().strip())
    return slug.strip("_")


def escribir_json_atomico(ruta, datos):
    ruta_tmp = ruta + ".tmp"
    with open(ruta_tmp, "w", encoding="utf-8") as f:
        json.dump(datos, f, ensure_ascii=False, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(ruta_tmp, ruta)


def escribir_texto_atomico(ruta, contenido):
    ruta_tmp = ruta + ".tmp"
    with open(ruta_tmp, "w", encoding="utf-8") as f:
        f.write(contenido)
        f.flush()
        os.fsync(f.fileno())
    os.replace(ruta_tmp, ruta)


def escribir_archivo_atomico(ruta_final, contenido):
    escribir_texto_atomico(ruta_final, contenido)


