def instalar_manejador_interrupciones():
    signal.signal(signal.SIGINT, _manejar_senal_interrupcion)
    try:
        signal.signal(signal.SIGTERM, _manejar_senal_interrupcion)
    except (AttributeError, ValueError):
        pass


