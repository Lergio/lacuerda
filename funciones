def nuevo_estado(letra):
    """Crea el estado independiente de una única letra."""
    return {
        "version": "5.3",
        "fuente": f"{URL_TABS}/{quote(letra)}/",
        "letra": letra,
        "inicio": time.strftime("%Y-%m-%d %H:%M:%S"),
        "fin": None,
        "paginas_indice": [],
        "artistas": [],
        "errores": [],
        "resumen": {
            "paginas_indice": 0,
            "artistas_encontrados": 0,
            "artistas_procesados": 0,
            "canciones_encontradas": 0,
            "versiones_descargadas": 0,
            "versiones_omitidas": 0,
            "versiones_fallidas": 0,
        },
    }


def cargar_estado_letra(letra):
    """Carga el JSON de una letra si existe y todavía sirve como control parcial."""
    ruta = os.path.join(carpeta_letra(letra), ARCHIVO_JSON)
    if not os.path.exists(ruta):
        return None
    try:
        with open(ruta, "r", encoding="utf-8") as f:
            estado = json.load(f)
        if estado.get("letra") != letra:
            return None
        return estado
    except (OSError, json.JSONDecodeError):
        return None


def construir_txt_control(estado):
    r = estado["resumen"]
    lineas = [
        "LaCuerda Downloader v5.3 - CONTROL",
        "=" * 70,
        f"Letra: {estado['letra'].upper()}",
        f"Fuente: {estado['fuente']}",
        f"Inicio: {estado['inicio']}",
        f"Fin: {estado.get('fin') or 'EN CURSO / INTERRUMPIDO'}",
        "",
        "RESUMEN",
        "-" * 70,
        f"Páginas de índice:       {r['paginas_indice']}",
        f"Artistas encontrados:    {r['artistas_encontrados']}",
        f"Artistas procesados:     {r['artistas_procesados']}",
        f"Canciones encontradas:   {r['canciones_encontradas']}",
        f"Versiones descargadas:   {r['versiones_descargadas']}",
        f"Versiones omitidas:      {r['versiones_omitidas']}",
        f"Versiones fallidas:      {r['versiones_fallidas']}",
        "",
        "ARTISTAS",
        "=" * 70,
    ]

    for artista in estado["artistas"]:
        lineas.append(f"\n{artista['nombre']}")
        lineas.append(f"URL: {artista['url']}")
        lineas.append(
            f"Canciones: {len(artista.get('canciones', []))}"
            f" / declaradas: {artista.get('canciones_declaradas', '?')}"
        )
        if artista.get("error"):
            lineas.append(f"ERROR: {artista['error']}")
        for cancion in artista.get("canciones", []):
            lcd = cancion.get("lcd") or "-"
            lineas.append(f"  - {cancion['titulo']} [{lcd}]")

    if estado["errores"]:
        lineas.extend(["", "ERRORES", "=" * 70])
        for error in estado["errores"]:
            lineas.append(f"[{error.get('tipo', 'ERROR')}] {error.get('url', '')}")
            lineas.append(f"  {error.get('mensaje', '')}")

    return "\n".join(lineas) + "\n"


def guardar_control(estado):
    """Guarda JSON y TXT dentro de la carpeta exclusiva de la letra."""
    carpeta = carpeta_letra(estado["letra"])
    os.makedirs(carpeta, exist_ok=True)
    escribir_json_atomico(os.path.join(carpeta, ARCHIVO_JSON), estado)
    escribir_texto_atomico(os.path.join(carpeta, ARCHIVO_TXT), construir_txt_control(estado))


# ---------------------------------------------------------------------------
# Registro de resultados (versiones, artistas e índices)
# ---------------------------------------------------------------------------
# Cada letra tiene un registro propio. Sirve para reintentar solo lo que
# falló, sin volver a recorrer todo:
#   - indices_fallidos:  páginas indexN.html que no se pudieron leer
#   - artistas_fallidos: páginas de artista que no se pudieron leer
#   - fallidas:          versiones (acordes, tablatura, ...) que no se guardaron
#   - descargadas:       versiones guardadas correctamente
#
# En memoria cada colección es {url: item}; en disco son listas.

COLECCIONES_REGISTRO = (
    "indices_fallidos",
    "artistas_fallidos",
    "fallidas",
    "descargadas",
)


def _ahora():
    return time.strftime("%Y-%m-%d %H:%M:%S")


def crear_item_version(artista, titulo, etiqueta, url, ruta, archivo):
    return {
        "artista": artista,
        "titulo": titulo,
        "etiqueta": etiqueta,
        "url": url,
        "ruta": ruta,
        "archivo": archivo,
    }


def nuevo_registro(letra):
    registro = {
        "version": VERSION_SCRIPT,
        "letra": letra,
        "actualizado": None,
    }
    for coleccion in COLECCIONES_REGISTRO:
        registro[coleccion] = {}
    return registro


def cargar_registro_letra(letra):
    """Carga el registro de una letra, o None si no existe o no sirve."""
    ruta = os.path.join(carpeta_letra(letra), ARCHIVO_REGISTRO_JSON)
    if not os.path.exists(ruta):
        return None
    try:
        with open(ruta, "r", encoding="utf-8") as f:
            datos = json.load(f)
        if datos.get("letra") != letra:
            return None
        registro = nuevo_registro(letra)
        registro["version"] = datos.get("version", VERSION_SCRIPT)
        registro["actualizado"] = datos.get("actualizado")
        for coleccion in COLECCIONES_REGISTRO:
            registro[coleccion] = {i["url"]: i for i in datos.get(coleccion, [])}
        return registro
    except (OSError, json.JSONDecodeError, KeyError, TypeError):
        return None


def registrar_fallo_en(registro, coleccion, datos, motivo, intentos_previos=None):
    """Registra (o actualiza) un fallo en la colección indicada, clave = url."""
    previo = registro[coleccion].get(datos["url"], {})
    if intentos_previos is None:
        intentos_previos = previo.get("intentos", 0)
    entrada = dict(datos)
    entrada["motivo"] = motivo
    entrada["intentos"] = intentos_previos + 1
    entrada["ultimo_intento"] = _ahora()
    registro[coleccion][datos["url"]] = entrada


def resolver_fallo(registro, coleccion, url):
    registro[coleccion].pop(url, None)


def registrar_descarga(registro, item, origen="descarga"):
    """Marca una versión como descargada (y la saca de fallidas si estaba)."""
    resolver_fallo(registro, "fallidas", item["url"])
    if origen == "existente" and item["url"] in registro["descargadas"]:
        return  # ya estaba registrada: se conserva su fecha original
    entrada = dict(item)
    entrada["origen"] = origen
    entrada["fecha"] = _ahora()
    registro["descargadas"][item["url"]] = entrada


def registrar_fallo(registro, item, motivo, intentos_previos=None):
    """Marca una versión como fallida y acumula la cantidad de intentos."""
    registro["descargadas"].pop(item["url"], None)
    registrar_fallo_en(registro, "fallidas", item, motivo, intentos_previos)


def contar_pendientes(registro):
    return (
        len(registro["indices_fallidos"])
        + len(registro["artistas_fallidos"])
        + len(registro["fallidas"])
    )


def _lineas_fallo(item, linea_titulo):
    return [
        "",
        linea_titulo,
        f"  URL:     {item['url']}",
        f"  Motivo:  {item.get('motivo', '?')}",
        f"  Intentos: {item.get('intentos', '?')}"
        f" (último: {item.get('ultimo_intento', '-')})",
    ]


def construir_txt_registro(registro):
    indices = sorted(registro["indices_fallidos"].values(), key=lambda i: i["offset"])
    artistas = sorted(
        registro["artistas_fallidos"].values(), key=lambda i: i["nombre"].lower()
    )
    fallidas = sorted(
        registro["fallidas"].values(),
        key=lambda i: (i["artista"].lower(), i["titulo"].lower()),
    )
    descargadas = list(registro["descargadas"].values())

    lineas = [
        f"LaCuerda Downloader v{VERSION_SCRIPT} - REGISTRO DE RESULTADOS",
        "=" * 70,
        f"Letra: {registro['letra'].upper()}",
        f"Actualizado: {registro.get('actualizado') or '-'}",
        "",
        f"Páginas de índice fallidas: {len(indices)}",
        f"Artistas fallidos:          {len(artistas)}",
        f"Versiones fallidas:         {len(fallidas)}",
        f"Versiones descargadas:      {len(descargadas)}",
        "",
        "ÍNDICES FALLIDOS (se reintentan desde el menú)",
        "=" * 70,
    ]
    if not indices:
        lineas.append("(ninguno)")
    for item in indices:
        lineas.extend(_lineas_fallo(item, f"Índice {item['offset']}"))

    lineas.extend(["", "ARTISTAS FALLIDOS (se reintentan desde el menú)", "=" * 70])
    if not artistas:
        lineas.append("(ninguno)")
    for item in artistas:
        lineas.extend(_lineas_fallo(item, item["nombre"]))

    lineas.extend(["", "VERSIONES FALLIDAS (se reintentan desde el menú)", "=" * 70])
    if not fallidas:
        lineas.append("(ninguna)")
    for item in fallidas:
        lineas.extend(
            _lineas_fallo(item, f"{item['artista']} - {item['titulo']} [{item['etiqueta']}]")
        )

    lineas.extend(["", "VERSIONES DESCARGADAS", "=" * 70])
    if not descargadas:
        lineas.append("(ninguna)")
    por_artista = {}
    for item in descargadas:
        por_artista.setdefault(item["artista"], []).append(item)
    for artista in sorted(por_artista, key=str.lower):
        items = por_artista[artista]
        lineas.append(f"\n{artista} ({len(items)})")
        for item in sorted(items, key=lambda i: (i["titulo"].lower(), i["etiqueta"])):
            lineas.append(f"  - {item['titulo']} [{item['etiqueta']}]")

    return "\n".join(lineas) + "\n"


def guardar_registro(registro):
    """Guarda el registro (.json y .txt) en la carpeta de la letra."""
    carpeta = carpeta_letra(registro["letra"])
    os.makedirs(carpeta, exist_ok=True)
    registro["actualizado"] = _ahora()

    datos = {
        "version": VERSION_SCRIPT,
        "letra": registro["letra"],
        "actualizado": registro["actualizado"],
        "resumen": {c: len(registro[c]) for c in COLECCIONES_REGISTRO},
    }
    for coleccion in COLECCIONES_REGISTRO:
        datos[coleccion] = list(registro[coleccion].values())

    escribir_json_atomico(os.path.join(carpeta, ARCHIVO_REGISTRO_JSON), datos)
    escribir_texto_atomico(
        os.path.join(carpeta, ARCHIVO_REGISTRO_TXT),
        construir_txt_registro(registro),
    )


