def url_indice(letra, offset=0):
    return f"{URL_TABS}/{quote(letra)}/index{offset}.html"


def extraer_paginas_indice(html, letra):
    """Obtiene indexXXX.html desde .multipag, incluyendo la página actual."""
    soup = BeautifulSoup(html, "html.parser")
    paginas = {0}
    bloque = soup.find("div", class_="multipag")

    if bloque:
        for li in bloque.find_all("li"):
            onclick = li.get("onclick", "")
            match = re.search(r"index(\d+)\.html", onclick)
            if match:
                paginas.add(int(match.group(1)))

        for enlace in bloque.find_all("a", href=True):
            match = re.search(r"index(\d+)\.html", enlace["href"])
            if match:
                paginas.add(int(match.group(1)))

    return sorted(paginas)


def extraer_artistas_indice(html, letra):
    soup = BeautifulSoup(html, "html.parser")
    ul = soup.find("ul", id="i_main")
    if not ul:
        return []

    artistas = []
    for li in ul.find_all("li", recursive=False):
        enlace = li.find("a", href=True)
        if not enlace:
            continue

        href = enlace["href"].strip()
        if not href:
            continue

        nombre = enlace.get_text(" ", strip=True)
        em = enlace.find("em")
        if em:
            nombre = nombre.replace(em.get_text(" ", strip=True), "").strip()

        span = li.find("span")
        declaradas = None
        if span:
            match = re.search(r"\d+", span.get_text(" ", strip=True))
            if match:
                declaradas = int(match.group(0))

        artistas.append({
            "nombre": nombre,
            "url": urljoin(DOMINIO_BASE, href),
            "letra_indice": letra,
            "canciones_declaradas": declaradas,
            "canciones": [],
        })

    return artistas


def obtener_indice(session, letra, offset):
    url = url_indice(letra, offset)
    print(f"   📑 Índice: {url}")
    try:
        respuesta = obtener(session, url)
    except Exception as e:
        return None, {
            "tipo": "indice_conexion",
            "url": url,
            "mensaje": mensaje_amigable_error(e),
        }

    if respuesta.status_code != 200:
        return None, {
            "tipo": "indice_http",
            "url": url,
            "mensaje": mensaje_amigable_codigo(respuesta.status_code),
        }

    return respuesta.text, None


